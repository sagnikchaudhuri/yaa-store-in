# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.

# ── Anthropic API ──────────────────────────────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Hidden Super Admin Auth ────────────────────────────────────────
# Controls the hidden Super Admin account on the dashboard login page.
# Verified server-side by POST /api/auth/super-admin — password is NEVER
# sent to the browser or baked into the client bundle.
# Leave both blank to disable the hidden Super Admin login entirely.
DEMO_SUPER_ADMIN_EMAIL=
DEMO_SUPER_ADMIN_PASSWORD=

# ── Supabase (future — not yet wired up) ──────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
